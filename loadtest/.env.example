# Known load-test accounts created by scripts/seed.py (dev/benchmark data only).
# Admin: created by the app at startup from ADMIN_EMAIL / ADMIN_PASSWORD in the root .env
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# 50 customers: customer001@loadtest.example ... customer050@loadtest.example
# They are the 50 busiest seeded users (orders are skewed towards low user numbers),
# i.e. "power users" with hundreds to thousands of orders each. All share one password.
CUSTOMER_PASSWORD=LoadTest123!

# Tokens must outlive a full run: set ACCESS_TOKEN_EXPIRE_MINUTES=600 in the root .env
# (the default 60 would also work, k6 logs in once in setup()).
BASE_URL=http://app:8000/api/v1

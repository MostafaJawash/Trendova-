# Database Configuration
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=replace-with-a-local-database-password
DATABASE_NAME=ecommerce

# JWT Configuration
# IMPORTANT: Generate a secure random secret key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The secret key must be at least 32 characters long
SECRET_KEY=replace-this-with-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Administrator
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
INVENTORY_MODE=grpc
INVENTORY_GRPC_ADDR=inventory-service:50051
INVENTORY_TIMEOUT_SECONDS=2.0
# Used only by inventory-db, never by the Python application
INVENTORY_DATABASE_URL=postgres://inventory:replace-with-inventory-password@inventory-db:5432/inventory?sslmode=disable
# DATABASE_URL=sqlite:///./trendova.db
